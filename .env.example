# JobMatch Production Environment Configuration
# Copy to .env and fill in your values

# Flask / Session
SECRET_KEY=your-secret-key-here-min-16-chars
FLASK_ENV=production

# Redis (for rate limiting in production)
# REDIS_URL=redis://localhost:6379
# For Cloudflare Tunnel / production, use Redis Cloud / Upstash / etc.
# REDIS_URL=redis://:password@host:port

# Paystack Billing (get keys from https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_PLAN_CODE=PLN_jobmatch_monthly
PAYSTACK_WEBHOOK_SECRET=whsec_xxx  # from Paystack webhook settings

# Resend Email (recommended for production)
# Get API key from https://resend.com
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=jobs@yourdomain.com
RESEND_FROM_NAME=JobMatch

# Gmail SMTP (fallback / dev only)
# HOPE_GMAIL_USER=your@gmail.com
# HOPE_GMAIL_APP_PASS=16-char-app-password

# LLM Providers (at least one required for CV tailoring)
# Get keys from respective platforms
GEMINI_API_KEY=xxx
GROQ_API_KEY=xxx
OPENROUTER_API_KEY=xxx
OPENAI_API_KEY=xxx

# Optional: Tesseract OCR path for scanned PDF CVs
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe